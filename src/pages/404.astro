---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" description="Страница не найдена. Вернитесь на главную или откройте архив вымышленного учебного журнала «Контур».">
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="error-code">Ошибка 404</p>
    <div class="recovery-content">
      <h1 id="not-found-heading">Страница не найдена</h1>
      <p class="explanation">Возможно, в адресе есть опечатка или страница больше не существует. Продолжить чтение можно с главной страницы или из архива выпусков.</p>
      <nav class="recovery-nav" aria-label="Куда перейти">
        <ul role="list">
          <li><a href="/">На главную</a></li>
          <li><a href="/archive/">В архив выпусков</a></li>
          <li>
            <a href="/search/" aria-describedby="search-notice">На страницу поиска</a>
            <p id="search-notice" class="search-notice">Поиск по заголовкам, именам авторов и ключевым словам.</p>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12) var(--space-8);
  }

  .error-code,
  .recovery-content {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .error-code {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-semibold);
  }

  h1 {
    max-inline-size: min(100%, var(--measure-title));
    margin-block-end: var(--space-6);
    font-family: var(--font-heading);
    font-size: var(--font-size-page-title);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-page-title);
  }

  .explanation {
    max-inline-size: min(100%, var(--measure-abstract));
    font-size: var(--font-size-abstract);
    line-height: var(--line-height-abstract);
  }

  .recovery-nav {
    margin-block-start: var(--space-8);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size-min);
    max-inline-size: 100%;
  }

  .search-notice {
    max-inline-size: min(100%, var(--measure-abstract));
    margin-block-start: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  @media (min-width: 64rem) {
    .not-found {
      grid-template-columns: repeat(var(--grid-columns-wide), minmax(0, 1fr));
      column-gap: var(--grid-gap);
      padding-block-start: var(--space-16);
    }

    .error-code {
      grid-column: 1 / span var(--grid-sidebar-columns);
    }

    .recovery-content {
      grid-column: var(--grid-content-start) / span var(--grid-content-columns);
    }
  }
</style>

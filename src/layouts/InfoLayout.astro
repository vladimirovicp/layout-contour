---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { infoPages, infoNotice } from '../data/info-pages';
import type { InfoPage } from '../data/info-pages';

interface Props {
  page: InfoPage;
}

const { page } = Astro.props;
const sections = page.sections.map((section) => ({
  ...section,
  paragraphs: section.paragraphs?.filter((paragraph) => paragraph.trim()) ?? [],
  items: section.items?.filter((item) => item.text.trim()) ?? [],
})).filter((section) => section.paragraphs.length > 0 || section.items.length > 0 || section.image);
---

<BaseLayout title={page.title} description={page.description}>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: page.title },
  ]} />

  <header class="info-header">
    <h1>{page.title}</h1>
    {page.description && <p class="introduction">{page.description}</p>}
    <p class="demo-notice">{infoNotice}</p>
  </header>

  <div class="info-grid">
    <nav class="info-nav" aria-label="Информация о журнале">
      <ul role="list">
        {infoPages.map((entry) => (
          <li><a href={`/${entry.slug}/`} aria-current={entry.slug === page.slug ? 'page' : undefined}>{entry.title}</a></li>
        ))}
      </ul>
    </nav>

    <div class="info-content">
      {sections.length > 0 ? sections.map((section, index) => (
        <section aria-labelledby={`info-section-${index + 1}`}>
          <h2 id={`info-section-${index + 1}`}>{section.heading}</h2>
          {section.image && (
            <figure class="info-image">
              <img
                src={section.image.src}
                width={section.image.width}
                height={section.image.height}
                alt={section.image.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {section.image.caption}
                <span class="image-credit">
                  Фото: <a href={section.image.credit.source}>{section.image.credit.author}</a>.
                  {' '}Лицензия: <a href={section.image.credit.licenseUrl}>{section.image.credit.license}</a>.
                </span>
              </figcaption>
            </figure>
          )}
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.items.length > 0 && (
            <ul>
              {section.items.map((item) => (
                <li>{item.label && <strong class="item-label">{item.label}</strong>}{item.text}</li>
              ))}
            </ul>
          )}
        </section>
      )) : <p>Содержание этой страницы пока не подготовлено. <a href="/">На главную</a></p>}
    </div>
  </div>
</BaseLayout>

<style>
  .info-header {
    margin-block-end: var(--space-12);
    overflow-wrap: anywhere;
  }

  h1,
  h2 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
  }

  h1 {
    max-inline-size: min(100%, var(--measure-title));
    margin-block-end: var(--space-6);
    font-size: var(--font-size-page-title);
    line-height: var(--line-height-page-title);
  }

  .introduction {
    max-inline-size: min(100%, var(--measure-abstract));
    font-size: var(--font-size-abstract);
    line-height: var(--line-height-abstract);
  }

  .demo-notice {
    max-inline-size: min(100%, var(--measure-abstract));
    margin-block-start: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  .info-grid {
    display: grid;
    gap: var(--space-12);
  }

  .info-nav,
  .info-content {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .info-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .info-nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size-min);
    max-inline-size: 100%;
  }

  .info-nav a[aria-current="page"] {
    font-weight: var(--font-weight-semibold);
  }

  .info-content {
    max-inline-size: min(100%, var(--measure-body));
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .info-content section + section {
    margin-block-start: var(--space-12);
  }

  h2 {
    margin-block-end: var(--space-5);
    font-size: var(--font-size-section-title);
    line-height: var(--line-height-section-title);
  }

  .info-content p + p,
  .info-content p + ul {
    margin-block-start: var(--space-6);
  }

  .info-content ul {
    padding-inline-start: var(--space-6);
  }

  .info-content li + li {
    margin-block-start: var(--space-4);
  }

  .item-label {
    display: block;
    font-weight: var(--font-weight-semibold);
  }

  .info-image {
    margin-block-end: var(--space-6);
  }

  .info-image img {
    inline-size: 100%;
    block-size: auto;
  }

  figcaption {
    margin-block-start: var(--space-3);
    color: var(--color-text-secondary);
    font-family: var(--font-interface);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-interface);
  }

  .image-credit {
    display: block;
    margin-block-start: var(--space-1);
  }

  @media (min-width: 64rem) {
    .info-grid {
      grid-template-columns: repeat(var(--grid-columns-wide), minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .info-nav {
      grid-column: 1 / span var(--grid-sidebar-columns);
    }

    .info-nav ul {
      flex-direction: column;
      align-items: flex-start;
    }

    .info-content {
      grid-column: var(--grid-content-start) / span var(--grid-content-columns);
    }
  }
</style>
